# Google Cloud / Vertex AI (required for Epic 3 embeddings and Epic 4 agent)
# For local development: run `gcloud auth application-default login`
# For CI/deployed: set GOOGLE_APPLICATION_CREDENTIALS to a service account key path
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# Embedding model (Vertex AI text-embedding-004 is the default)
VERTEX_EMBEDDING_MODEL=text-embedding-004

# Generative model for agent orchestration (Epic 4)
VERTEX_GENERATIVE_MODEL=gemini-2.0-flash

# Database paths (defaults — override for alternate locations)
DB_PATH=data/cmdb.db
CHROMA_PATH=data/chroma
